        "absolute_path",
        "exact_gid",
        "exact_mode",
        "exact_nlink",
        "exact_uid",
        "executable_required",
        "isolated_flags",
        "reported_version",
        "sha256",
        "symlink_components_forbidden"
      ],
      "type": "object"
    },
    "record_versions": {
      "const": {
        "checkpoint": [1],
        "resume": [2],
        "root_authorization": [1]
      }
    },
    "recovery_contract": {
      "additionalProperties": false,
      "properties": {
        "allowed_disclosure": {
          "const": "stored_primary_operator_identity_only"
        },
        "audit_events": {
          "const": [
            "attempt_started",
            "identity_acknowledged",
            "recovery_completed",
            "recovery_failed",
            "recovery_indeterminate"
          ]
        },
        "challenge_phrase_prefix": {
          "const": "AUTHORIZE RECOVER_OPERATOR_IDENTITY"
        },
        "expected_generation": { "const": 1 },
        "expected_state": { "const": "PRIMARY_REVIEW_REQUIRED" },
        "historical_binding": {
          "additionalProperties": false,
          "properties": {
            "authoring_procedure_identity_sha256": {
              "const": "bc0b990d878db1e2c72bd4ac91314fe32261a454ac38505b7ea6df4af2b5f3d8"
            },
            "execution_checkout_sha": {
              "const": "b1986e4079b52edbb4ef5cd4c56ed4d20af07195"
            },
            "operator_session_procedure_identity_sha256": {
              "const": "ee0dbb3ecb9b469bef49c1fe0305ea60602bbbbaddd2f551a7774dad6cacdc23"
            },
            "python": {
              "additionalProperties": false,
              "properties": {
                "absolute_path": {
                  "const": "/Library/Developer/CommandLineTools/Library/Frameworks/Python3.framework/Versions/3.9/bin/python3.9"
                },
                "reported_version": { "const": "cpython:3.9.6" },
                "sha256": {
                  "const": "4b42b1a117605cafc8607b67b0892a609c2cd125012dd56288abeed8c89cdfb1"
                }
              },
              "required": ["absolute_path", "reported_version", "sha256"],
              "type": "object"
            }
          },
          "required": [
            "authoring_procedure_identity_sha256",
            "execution_checkout_sha",
            "operator_session_procedure_identity_sha256",
            "python"
          ],
          "type": "object"
        },
        "no_retry_acknowledgement": {
          "const": "NO_RETRY_AFTER_PRIVATE_ACCESS"
        },
        "operator_root_mutation": {
          "const": "temporary_lock_lifecycle_only"
        },
        "ordinary_action_dispatched": { "const": false }
      },
      "required": [
        "allowed_disclosure",
        "audit_events",
        "challenge_phrase_prefix",
        "expected_generation",
        "expected_state",
        "historical_binding",
        "no_retry_acknowledgement",
        "operator_root_mutation",
        "ordinary_action_dispatched"
      ],
      "type": "object"
    },
    "repository": {
      "const": {
        "name": "focus-flow-score",
        "owner": "starstruck86"
      }
    },
    "review_attestation_discovery": {
      "additionalProperties": false,
      "properties": {
        "filename_pattern": {
          "const": "^lovable-toc-operator-identity-recovery-review-([0-9a-f]{40})-([0-9a-f]{64})[.]json$"
        },
        "home_resolution": { "const": "passwd_database_effective_uid" },
        "relative_parent": {
          "const": "Library/Application Support/focus-flow-score/migration-approvals/toc-operator-identity-recovery"
        },
        "required_file_mode": { "const": "0400" },
        "required_file_nlink": { "const": 1 },
        "required_parent_mode": { "const": "0700" },
        "schema_relative_path": {
          "const": "scripts/migration/verification/lovable-toc-independent-claude-review-attestation.schema.json"
        },
        "selection": {
          "const": "exactly_one_matching_current_checkout_and_approval_sha256"
        }
      },
      "required": [
        "filename_pattern",
        "home_resolution",
        "relative_parent",
        "required_file_mode",
        "required_file_nlink",
        "required_parent_mode",
        "schema_relative_path",
        "selection"
      ],
      "type": "object"
    },
    "reviewed_files": { "$ref": "#/$defs/reviewedFiles" },
    "verification_labels": {
      "const": [
        "checkout_verified",
        "external_review_verified",
        "operator_execution_approval_verified",
        "python_verified",
        "recovery_approval_verified",
        "recovery_procedure_verified",
        "repository_verified",
        "reviewed_files_verified",
        "tty_verified"
      ]
    }
  },
  "required": [
    "approval_discovery",
    "artifact_kind",
    "audit_storage",
    "checkout_policy",
    "format_version",
    "independent_review_policy",
    "procedure_identity_formula",
